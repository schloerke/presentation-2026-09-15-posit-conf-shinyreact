#!/bin/bash -e
# Syntax-highlight R for the shinyreact Keynote theme.
#
# Keynote cannot highlight code, but it keeps colour on a rich-text paste. This
# puts RTF on the clipboard; paste into a code placeholder with plain Cmd-V.
# "Paste and Match Style" strips the colours, which is the whole point.
#
#   format_r_clipboard              # highlight whatever is on the clipboard
#   format_r_clipboard app.r     # ...or a file
#
# Colours live in shinyreact-dark.theme (DESIGN.md section 4.1, all >= 7:1).
# --font-size is in POINTS: 17pt == the spec's 34px on the 1920x1080 canvas.

if [ -z "`command -v highlight`" ]; then
  echo "installing highlight!!!"
  brew install highlight
fi

THEME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/shinyreact-dark.theme"

if [ -n "$1" ]; then
  SRC=(cat "$1")
else
  SRC=(pbpaste)
fi

"${SRC[@]}" | highlight -s "$THEME" --syntax=r -O rtf \
  --font "Source Code Pro" --font-size 17 | pbcopy -Prefer rtf
echo "clipboard updated with R syntax highlighted code"
