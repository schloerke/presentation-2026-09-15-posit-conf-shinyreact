Description="shinyreact dark"

-- Token colours for the shinyreact Keynote theme.
-- Values come from DESIGN.md section 4.1 and are measured against the #141519
-- code panel; every one clears 7:1 contrast. LineComment/BlockComment are
-- #9aa3b2 rather than the conventional mid-grey, which measures 3.77:1 and
-- disappears from the back of a room.

Categories = {"dark"}

Default        = { Colour="#f2f4f8" }
Canvas         = { Colour="#141519" }
Number         = { Colour="#ffb86c" }
Escape         = { Colour="#ffb86c" }
String         = { Colour="#9fe88d" }
StringPreProc  = { Colour="#9fe88d" }
BlockComment   = { Colour="#9aa3b2" }
LineComment    = { Colour="#9aa3b2" }
PreProcessor   = { Colour="#6fd4e8" }
LineNum        = { Colour="#9aa3b2" }
Operator       = { Colour="#f2f4f8" }
Interpolation  = { Colour="#6fd4e8" }

-- kwa keywords, kwb types/builtins, kwc functions, kwd the rest.
-- Cyan is the theme's "this is a name that does something" colour; violet is
-- reserved for language keywords.
Keywords = {
  { Colour="#c7a0ff" },
  { Colour="#6fd4e8" },
  { Colour="#6fd4e8" },
  { Colour="#6fd4e8" },
  { Colour="#6fd4e8" },
  { Colour="#f2f4f8" },
}

SemanticTokenTypes = {
  { Type = 'type',       Style = Keywords[2] },
  { Type = 'class',      Style = Keywords[2] },
  { Type = 'struct',     Style = Keywords[2] },
  { Type = 'interface',  Style = Keywords[2] },
  { Type = 'function',   Style = Keywords[3] },
  { Type = 'method',     Style = Keywords[3] },
  { Type = 'macro',      Style = Keywords[3] },
  { Type = 'parameter',  Style = Default },
  { Type = 'variable',   Style = Default },
  { Type = 'property',   Style = Default },
  { Type = 'enumMember', Style = Number },
  { Type = 'keyword',    Style = Keywords[1] },
  { Type = 'string',     Style = String },
  { Type = 'number',     Style = Number },
  { Type = 'comment',    Style = LineComment },
}
