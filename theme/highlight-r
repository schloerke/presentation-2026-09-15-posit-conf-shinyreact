#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pygments"]
# ///
"""Syntax-highlight R for the shinyreact Keynote theme.

Reads a file, stdin, or the clipboard; puts RTF on the clipboard. Paste into a
code placeholder with plain Cmd-V - "Paste and Match Style" strips the colours,
which is the whole point.

    ./highlight-r path/to/file
    ./highlight-r                 # highlight whatever is on the clipboard

Dependencies are declared inline (PEP 723): uv fetches pygments on first run,
so there is nothing to install.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _highlight import run  # noqa: E402

if __name__ == "__main__":
    run("r", sys.argv[1:], label="R")
